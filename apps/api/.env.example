# Opcional: memory | supabase
# Si se omite y existen SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY, se usa supabase automaticamente.
PERSISTENCE_DRIVER=memory
AGENT_LLM_MODEL=gemini-2.5-flash
# Tiempo maximo de espera para la respuesta del nodo agente (ms)
# AGENT_TIMEOUT_MS=30000
GOOGLE_API_KEY=your_google_api_key_here
PORT=3037
# Esto es opcional si es que se quiere utilizar bases vectoriales
# TOOL_EMBEDDING_MODEL=gemini-embedding-001
# TOOL_EMBEDDING_DIMENSIONS=768
# TOOL_EMBEDDING_BATCH_SIZE=32
# GEMINI_API_KEY=your_gemini_api_key_here
# Required when PERSISTENCE_DRIVER=supabase
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Esto es opcional, solo si quieres cargar datos iniciales para herramientas de búsqueda
# FAQ_JSON_PATH=faq.json
# AUTOS_JSON_PATH=autos.json
# DATES_JSON_PATH=dates.json
