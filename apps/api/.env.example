AGENT_LLM_MODEL=gemini-3-flash
GOOGLE_API_KEY=your_google_api_key_here
PORT=3037
# Opcional: rutas de JSON locales para herramientas (RAG estatico)
# FAQ_JSON_PATH=faq.json
# AUTOS_JSON_PATH=autos.json
# DATES_JSON_PATH=dates.json

# Telegram channel (opcional)
# Requiere: TELEGRAM_BOT_TOKEN
# TELEGRAM_TRANSPORT admite: polling (default) | webhook
# TELEGRAM_BOT_TOKEN=123456:abcDEF...
# Opcional fallback si el usuario aun no envia /flow <FLOW_ID>
# TELEGRAM_DEFAULT_FLOW_ID=flow_id_existente
# TELEGRAM_TRANSPORT=polling
# TELEGRAM_POLLING_TIMEOUT_SECONDS=25
# TELEGRAM_POLLING_RETRY_DELAY_MS=1500
#
# Si usas webhook:
# POST /v1/channels/telegram/webhook/:secret
# TELEGRAM_TRANSPORT=webhook
# TELEGRAM_WEBHOOK_SECRET=un_secreto_largo
