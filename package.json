{
  "name": "devday-challenge-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "install:all": "pnpm install",
    "predev": "pnpm install",
    "dev": "pnpm -r --parallel --filter @devday/api --filter web dev",
    "dev:api": "pnpm --filter @devday/api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm -r --parallel --filter @devday/api --filter web start",
    "start:prod": "pnpm -r --parallel --filter @devday/api --filter web start:prod",
    "prod": "pnpm run build && pnpm run start:prod",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "volta": {
    "node": "25.7.0"
  }
}
